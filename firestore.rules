rules_version = '2';
// Règles de TEST pour Sëtal AAAS : lecture et écriture ouvertes sur les deux collections du prototype,
// jusqu'au 31/12/2026. À remplacer par des règles avec authentification avant toute mise en service.
service cloud.firestore {
  match /databases/{database}/documents {
    match /demandes/{id} { allow read, write: if request.time < timestamp.date(2026, 12, 31); }
    match /chauffeurs/{id} { allow read, write: if request.time < timestamp.date(2026, 12, 31); }
    match /{document=**} { allow read, write: if false; }
  }
}
